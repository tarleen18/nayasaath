NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=postgresql://nayasaath:nayasaath_local_only@localhost:5433/nayasaath?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-32-random-bytes
OTP_PROVIDER=disabled
# Development only: set a fixed six-digit OTP for local testing; never set in production.
OTP_DEV_FIXED_CODE=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=nayasaath-private
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
PAYMENT_PROVIDER=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
KYC_PROVIDER=disabled
KYC_PROVIDER_API_KEY=
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=NayaSaath <no-reply@nayasaath.local>
# Comma-separated exact email addresses. An empty allowlist permits all non-blocked addresses.
AUTH_EMAIL_ALLOWLIST=
AUTH_EMAIL_BLOCKLIST=
SMS_PROVIDER=disabled
SENTRY_DSN=

# Bootstrap a privileged admin once with: ADMIN_EMAIL=... ADMIN_PASSWORD=... pnpm admin:create
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=SUPER_ADMIN
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
